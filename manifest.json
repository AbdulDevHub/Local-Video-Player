{
   "manifest_version": 3,
   "name": "Local Video Player",
   "short_name": "Video Player",
   "description": "Private player for local videos and music: resume, playlists, subtitles, 16x speed, 500% volume and 30+ keyboard shortcuts.",
   "author": "Abdul Khan",
   "version": "3.0.0",
   "background": {
      "service_worker": "scripts/background.js"
   },
   "icons": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "192": "icons/favicon.png"
   },
   "action": {},
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default": "Alt+V"
         }
      }
   },
   "homepage_url": "https://abduldevhub.github.io/Local-Video-Player/",
   "minimum_chrome_version": "120"
}
